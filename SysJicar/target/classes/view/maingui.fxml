<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="bp" prefHeight="760.0" prefWidth="1280.0" styleClass="sysjicar-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysjicar.controller.MainGuiController">
    <top>
        <VBox spacing="0">
            <HBox fx:id="navigationBar" alignment="CENTER_LEFT" spacing="4" styleClass="navigation-bar">
                <padding><Insets bottom="7" left="12" right="12" top="7" /></padding>
                <Button fx:id="btnEscritorio" onAction="#mostrarEscritorio" styleClass="nav-button" text="Escritorio" />
                <Button fx:id="btnProductos" onAction="#mostrarProductos" styleClass="nav-button" text="Productos" />
                <Button fx:id="btnVentas" onAction="#mostrarVentas" styleClass="nav-button" text="Ventas" />
                <Button fx:id="btnInventario" onAction="#mostrarInventario" styleClass="nav-button" text="Inventario" />
                <Button fx:id="btnUsuarios" onAction="#mostrarUsuarios" styleClass="nav-button" text="Usuarios" />
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT" spacing="1">
                    <Label fx:id="lblUsuario" styleClass="session-user" text="Usuario" />
                    <Label fx:id="lblPerfil" styleClass="session-role" text="Perfil" />
                </VBox>
                <ImageView fx:id="imgLogo" fitHeight="58" fitWidth="112" preserveRatio="true" smooth="true" />
                <Button onAction="#cerrarSesion" styleClass="logout-button" text="Salir" />
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area">
            <VBox alignment="CENTER" spacing="12" />
        </StackPane>
    </center>
</BorderPane>
